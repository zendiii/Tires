# Copy to .env.local and fill in. NEVER commit real credentials.
#
# .env.local is gitignored. On Vercel these go in
# Project → Settings → Environment Variables.
#
# IMPORTANT: none of these may be prefixed with VITE_. Vite inlines any
# VITE_* variable into the JavaScript bundle, which would publish your
# supplier credentials to every visitor. They are read only by serverless
# functions running on the server.

# --- ATD / Tirewire Connections Center ---
# From your ATD dealer portal or Tirewire (developer@tirewire.com).
ATD_ACCESS_KEY=
ATD_GROUP_TOKEN=
# The supplier ConnectionID for your ATD account.
# Run `node scripts/atd-check.mjs` to discover it.
ATD_CONNECTION_ID=

# Optional global pricing nudge applied on top of the markup ladder in
# api/_lib/pricing.ts. 1 = no change, 1.05 = 5% across the board,
# 0.95 = a sale. Leave blank for normal pricing.
ATD_MARKUP_MULTIPLIER=

# --- Stripe payments ---
# Dashboard → Developers → API keys. Use the TEST key (sk_test_...) locally and
# in Vercel Preview; only Production gets sk_live_.
#
# Safety rail worth knowing: checkout will price from the bundled sample
# catalog under a TEST key, but REFUSES to under a live key. A live deploy
# therefore cannot sell sample inventory even if someone forgets a flag.
STRIPE_SECRET_KEY=

# Dashboard → Developers → Webhooks → your endpoint → "Signing secret".
# Starts whsec_. This is what proves an incoming "payment succeeded" really
# came from Stripe; without it the webhook refuses every event.
# It is DIFFERENT per endpoint and different between test and live mode.
STRIPE_WEBHOOK_SECRET=

# Stripe Tax. Leave blank until you've added your tax registration under
# Dashboard → Tax — turning it on beforehand makes every checkout fail.
STRIPE_AUTOMATIC_TAX=

# Absolute base URL used to build Stripe's return links, e.g.
# https://dinosmobiletires.com — no trailing slash. Deliberately not taken
# from the request headers, which a visitor can forge. Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL is used as a fallback on previews.
SITE_URL=http://localhost:5173

# Note: there is NO Stripe publishable key here. We use hosted Checkout, so
# the browser is just redirected to stripe.com and never loads Stripe.js.
